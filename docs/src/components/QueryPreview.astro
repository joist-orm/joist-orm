---
import "./query-preview.css";

interface Props {
  label?: string;
}

const { label = "em.query examples" } = Astro.props;
---

<div class="query-preview not-content" role="region" aria-label={label} aria-roledescription="carousel">
  <div class="query-preview__controls"></div>
  <div class="query-preview__slides">
    <slot />
  </div>
</div>

<script>
  import { mountQueryPreviews } from "./QueryPreviewControls";

  document.querySelectorAll<HTMLElement>(".query-preview").forEach(mountQueryPreviews);
</script>
