{
  "version": "2.0.3",
  "name": "joist",
  "scripts": {
    "build": "yarn clean && tsdown && yarn typecheck:packages && yarn typecheck:consumers && node scripts/test-module-sync.mjs",
    "build:watch": "tsdown --watch --no-clean",
    "clean": "rm -rf build && find packages -type d -name build -prune -exec rm -rf '{}' + && find packages -name '*.tsbuildinfo' -delete",
    "semantic-release": "semantic-release",
    "publish-next": "./scripts/publish-next.sh",
    "trust-npm-circleci": "node ./scripts/trust-npm-circleci.mjs",
    "migrate": "yarn workspaces foreach --all run migrate",
    "codegen": "yarn workspaces foreach --all run codegen",
    "format": "oxlint --fix packages && oxfmt --write 'packages/**/{schema,migrations,src}/**/*.{ts,js,tsx,jsx,graphql}'",
    "format:check": "oxlint packages && oxfmt --check 'packages/**/{schema,migrations,src}/**/*.{ts,js,tsx,jsx,graphql}'",
    "start": "yarn mprocs",
    "test": "yarn workspaces foreach --all run test",
    "typecheck:packages": "yarn workspaces foreach --all --include 'joist-*' --exclude 'joist-tests-*' --exclude joist-docs exec tsc --project tsconfig.json --noEmit --composite false",
    "typecheck:consumers": "tsc --project tsconfig.unit-tests.json --composite false && yarn workspaces foreach --all --include 'joist-tests-*' exec tsc --project tsconfig.json --composite false",
    "typecheck:watch": "tsc --build --watch --emitDeclarationOnly --preserveWatchOutput",
    "docker": "docker-compose build",
    "db": "docker compose up db --wait && docker compose exec db ./reset.sh && yarn migrate && yarn codegen",
    "psql": "docker compose exec db ./console.sh"
  },
  "private": true,
  "workspaces": [
    "docs",
    "packages/codegen",
    "packages/core",
    "packages/drivers/bun-pg",
    "packages/graphql-codegen",
    "packages/graphql-resolver-utils",
    "packages/knex",
    "packages/migration-utils",
    "packages/orm",
    "packages/utils",
    "packages/test-utils",
    "packages/tests/bun",
    "packages/tests/bun-sql-pg",
    "packages/tests/integration",
    "packages/tests/schema-misc",
    "packages/tests/slug-ids",
    "packages/tests/esm",
    "packages/tests/immediate-foreign-keys",
    "packages/tests/number-ids",
    "packages/tests/untagged-ids",
    "packages/tests/uuid-ids",
    "packages/tests/temporal",
    "packages/tests/vitest"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node20": "^20.1.9",
    "env-cmd": "^11.0.0",
    "expect-type": "^1.4.0",
    "mprocs": "^0.9.6",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "semantic-release": "^25.0.9",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "marked": "15.0.8"
  },
  "packageManager": "yarn@4.18.0"
}
