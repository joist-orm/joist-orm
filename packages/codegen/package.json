{
  "name": "joist-codegen",
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/codegen"
  },
  "main": "build/index.cjs",
  "module": "build/index.js",
  "types": "build/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "module-sync": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.js"
    }
  },
  "bin": "build/index.cjs",
  "files": [
    "build",
    "skills"
  ],
  "peerDependencies": {
    "joist-utils": "workspace:*",
    "knex": "^3.1.0",
    "pg": "^8.23.0"
  },
  "dependencies": {
    "@dprint/formatter": "^0.5.1",
    "@dprint/json": "^0.21.3",
    "@inquirer/prompts": "^8.6.0",
    "@types/jscodeshift": "^17.3.0",
    "@types/pluralize": "^0.0.33",
    "change-case": "^4.1.2",
    "fast-glob": "^3.3.3",
    "jscodeshift": "^17.4.0",
    "jsonc-parser": "^3.3.1",
    "pg-structure": "^7.15.3",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.6",
    "ts-poet": "^6.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
