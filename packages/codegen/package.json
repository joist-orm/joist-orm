{
  "name": "joist-codegen",
  "version": "2.0.3",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/codegen"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "bun": "./build/esm/index.mjs",
      "module-sync": "./build/esm/index.mjs",
      "import": "./build/esm/index.mjs",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./build/codemods": {
      "types": "./build/codemods/index.d.ts",
      "bun": "./build/esm/codemods/index.mjs",
      "module-sync": "./build/esm/codemods/index.mjs",
      "import": "./build/esm/codemods/index.mjs",
      "require": "./build/codemods/index.js",
      "default": "./build/codemods/index.js"
    },
    "./build/docs": {
      "types": "./build/docs/index.d.ts",
      "bun": "./build/esm/docs/index.mjs",
      "module-sync": "./build/esm/docs/index.mjs",
      "import": "./build/esm/docs/index.mjs",
      "require": "./build/docs/index.js",
      "default": "./build/docs/index.js"
    },
    "./build/*.js": {
      "types": "./build/*.d.ts",
      "bun": "./build/esm/*.mjs",
      "module-sync": "./build/esm/*.mjs",
      "import": "./build/esm/*.mjs",
      "require": "./build/*.js",
      "default": "./build/*.js"
    },
    "./build/*": {
      "types": "./build/*.d.ts",
      "bun": "./build/esm/*.mjs",
      "module-sync": "./build/esm/*.mjs",
      "import": "./build/esm/*.mjs",
      "require": "./build/*.js",
      "default": "./build/*.js"
    }
  },
  "bin": "build/index.js",
  "files": [
    "build",
    "skills"
  ],
  "peerDependencies": {
    "joist-utils": "workspace:*",
    "knex": "^3.1.0",
    "pg": "^8.22.0"
  },
  "dependencies": {
    "@dprint/formatter": "^0.5.1",
    "@dprint/json": "^0.21.3",
    "@inquirer/prompts": "^8.5.2",
    "@types/jscodeshift": "^17.3.0",
    "@types/pluralize": "^0.0.33",
    "change-case": "^4.1.2",
    "fast-glob": "^3.3.3",
    "jscodeshift": "^17.4.0",
    "jsonc-parser": "^3.3.1",
    "pg-structure": "^7.15.3",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.6",
    "ts-poet": "^6.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "7.0.2"
  }
}
