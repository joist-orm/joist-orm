{
  "name": "joist-graphql-codegen",
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/graphql-codegen"
  },
  "main": "build/index.cjs",
  "module": "build/index.js",
  "types": "build/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "module-sync": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "files": [
    "build"
  ],
  "peerDependencies": {
    "joist-codegen": "workspace:*",
    "joist-utils": "workspace:*",
    "pg-types": "^4.1.0"
  },
  "dependencies": {
    "@dprint/formatter": "^0.5.1",
    "@dprint/json": "^0.21.3",
    "change-case": "^4.1.2",
    "graphql": "^17.0.2",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.6",
    "ts-poet": "^6.12.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "7.0.2"
  }
}
