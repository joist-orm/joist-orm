{
  "name": "joist-graphql-plugins",
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/graphql-plugins"
  },
  "main": "build/index.cjs",
  "module": "build/index.js",
  "types": "build/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "module-sync": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "peerDependencies": {
    "@envelop/core": "^5.5.1",
    "graphql": "^17.0.2",
    "joist-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@envelop/core": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "7.0.2"
  }
}
