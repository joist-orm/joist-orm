{
  "name": "joist-knex",
  "version": "2.0.3",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/knex"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "bun": "./build/esm/index.mjs",
      "module-sync": "./build/esm/index.mjs",
      "import": "./build/esm/index.mjs",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./build/*.js": {
      "types": "./build/*.d.ts",
      "bun": "./build/esm/*.mjs",
      "module-sync": "./build/esm/*.mjs",
      "import": "./build/esm/*.mjs",
      "require": "./build/*.js",
      "default": "./build/*.js"
    },
    "./build/*": {
      "types": "./build/*.d.ts",
      "bun": "./build/esm/*.mjs",
      "module-sync": "./build/esm/*.mjs",
      "import": "./build/esm/*.mjs",
      "require": "./build/*.js",
      "default": "./build/*.js"
    }
  },
  "files": [
    "build"
  ],
  "peerDependencies": {
    "joist-core": "workspace:*",
    "knex": "^3.1.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "7.0.2"
  }
}
