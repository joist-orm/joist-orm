{
  "name": "joist-migration-utils",
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/migration-utils"
  },
  "main": "build/index.cjs",
  "module": "build/index.js",
  "types": "build/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "module-sync": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "peerDependencies": {
    "joist-utils": "workspace:*",
    "pg": "^8.22.0"
  },
  "dependencies": {
    "@types/pluralize": "^0.0.33",
    "node-pg-migrate": "^8.0.4",
    "pg-structure": "^7.15.3",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "7.0.2"
  }
}
