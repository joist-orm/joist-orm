{
  "name": "joist-tests-esm",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joist-orm/joist-orm.git",
    "directory": "packages/tests/esm"
  },
  "scripts": {
    "migrate": "DATABASE_URL=postgres://joist:local@localhost:5435/esm node-pg-migrate up --decamelize=false --migrations-dir=./migrations",
    "codegen": "node ../../codegen && graphql-codegen --config graphql-codegen.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --logHeapUsage"
  },
  "dependencies": {
    "joist-graphql-resolver-utils": "workspace:*",
    "joist-orm": "workspace:*",
    "node-pg-migrate": "^8.0.4",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@homebound/graphql-typescript-simple-resolvers": "^1.59.0",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "30.4.2",
    "jest-junit": "^17.0.0",
    "joist-codegen": "workspace:*",
    "joist-core": "workspace:*",
    "joist-graphql-codegen": "workspace:*",
    "joist-migration-utils": "workspace:*",
    "joist-test-utils": "workspace:*",
    "joist-utils": "workspace:*",
    "superstruct": "^2.0.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "7.0.2"
  }
}
