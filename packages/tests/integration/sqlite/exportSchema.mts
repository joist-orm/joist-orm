import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

import { type Column, loadPgMetadata } from "joist-codegen/pgMetadata";
import { newPgConnectionConfig } from "joist-utils";
import { Client } from "pg";

/**
 * Exports the migrated integration model as a real SQLite schema for shared runtime tests.
 *
 * Reads physical columns, constraints, and enum rows from PostgreSQL's catalog. Database-specific
 * expressions remain unsupported so the shared suite can expose those compatibility gaps.
 */
async function exportSchema(): Promise<void> {
  const client = new Client(newPgConnectionConfig());
  await client.connect();
  try {
    const catalog = await loadPgMetadata(client);
    const tables = catalog.tables.filter((table) => table.schema.name === "public" && table.name !== "pgmigrations");
    const predicates = await client.query<{ name: string; predicate: string | null }>(
      `SELECT c.relname AS name, pg_get_expr(i.indpred, i.indrelid) AS predicate
       FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid`,
    );
    const predicatesByName = new Map(predicates.rows.map((row) => [row.name, row.predicate]));
    const statements = [
      "-- Generated by yarn sqlite:export-schema from the migrated PostgreSQL integration database.",
      "-- Shares the existing domain model; PostgreSQL-only expressions and storage are not emulated.",
    ];

    for (const table of tables) {
      const primaryKey = table.primaryKey?.columns ?? [];
      const definitions = table.columns.map((column) => columnDefinition(column, primaryKey));
      if (primaryKey.length > 1) {
        definitions.push(`PRIMARY KEY (${primaryKey.map((column) => quote(column.name)).join(", ")})`);
      }
      for (const fk of table.foreignKeys) {
        definitions.push(
          `FOREIGN KEY (${fk.columns.map((column) => quote(column.name)).join(", ")}) ` +
            `REFERENCES ${quote(fk.referencedTable.name)} (${fk.referencedTable.primaryKey!.columns.map((column) => quote(column.name)).join(", ")}) ` +
            `ON DELETE ${fk.onDelete} DEFERRABLE INITIALLY DEFERRED`,
        );
      }
      statements.push(`CREATE TABLE ${quote(table.name)} (\n  ${definitions.join(",\n  ")}\n);`);
      for (const index of table.indexes) {
        if (!index.isUnique || index.columns.length === 0 || index.columns.every((column) => column.isPrimaryKey))
          continue;
        const predicate = predicatesByName.get(index.name)?.replaceAll("::text", "");
        statements.push(
          `CREATE UNIQUE INDEX ${quote(index.name)} ON ${quote(table.name)} ` +
            `(${index.columns.map((column) => quote(column.name)).join(", ")})${predicate ? ` WHERE ${predicate}` : ""};`,
        );
      }

      // Enum lookup rows are fixture data, unlike entity rows left over from a test run.
      if (
        table.columns.some((column) => column.name === "code") &&
        table.columns.some((column) => column.name === "name")
      ) {
        const rows = await client.query(`SELECT * FROM ${quote(table.name)} ORDER BY id`);
        for (const row of rows.rows) {
          const columns = Object.keys(row);
          statements.push(
            `INSERT INTO ${quote(table.name)} (${columns.map(quote).join(", ")}) VALUES (${columns.map((column) => literal(row[column])).join(", ")});`,
          );
        }
      }
    }
    writeFileSync(fileURLToPath(new URL("./schema.sql", import.meta.url)), `${statements.join("\n\n")}\n`);
  } finally {
    await client.end();
  }
}

/**
 * Declares a real catalog column using the SQLite storage conventions of the shared fixture.
 *
 * Retains logical types for the existing generated codecs while adapting primary keys and timestamps.
 */
function columnDefinition(column: Column, primaryKey: readonly Column[]): string {
  if (primaryKey.length === 1 && column.name === "id") return `${quote(column.name)} INTEGER PRIMARY KEY AUTOINCREMENT`;

  const type = column.type.shortName ?? column.type.name;
  // Declared array types retain the shared generated codecs; SQLite stores their values as JSON text.
  const declaredType = column.arrayDimension > 0 ? `${type}[]` : type === "bytea" ? "BLOB" : type;

  // PostgreSQL's timestamp triggers fill omitted fixture timestamps; SQLite uses an equivalent default.
  const defaultValue = column.isGenerated
    ? undefined
    : (column.name === "created_at" || column.name === "updated_at") && column.defaultValue === null
      ? "(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))"
      : sqliteDefault(column.defaultValue, column.arrayDimension > 0);

  return [
    quote(column.name),
    quote(declaredType),
    type === "citext" ? "COLLATE NOCASE" : "",
    column.notNull ? "NOT NULL" : "",
    defaultValue === undefined ? "" : `DEFAULT ${defaultValue}`,
  ]
    .filter(Boolean)
    .join(" ");
}

/** Converts only the defaults used by the existing integration migrations. */
function sqliteDefault(value: string | null, isArray: boolean): string | undefined {
  if (value === null) return undefined;
  if (value === "now()") return "(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))";
  // Non-id serial columns are PostgreSQL-specific; their initial default is sufficient to build the fixture.
  if (value.startsWith("nextval(")) return "1";
  const scalar = value.replace(/::[\w\s]+(?:\[\])?$/, "");
  if (scalar === "true") return "1";
  if (scalar === "false") return "0";
  if (isArray && (scalar === "'{}'" || scalar === "ARRAY[]")) return "'[]'";
  if (/^-?\d+(?:\.\d+)?$/.test(scalar) || /^'(?:[^']|'')*'$/.test(scalar)) return scalar;
  throw new Error(`Unsupported SQLite fixture default: ${value}`);
}

/** Quotes a SQLite identifier, including declared types containing spaces or brackets. */
function quote(value: string): string {
  return `"${value.replaceAll('"', '""')}"`;
}

/** Encodes an enum lookup value in the generated SQL fixture. */
function literal(value: unknown): string {
  if (value === null) return "NULL";
  if (typeof value === "number") return String(value);
  if (typeof value === "boolean") return value ? "1" : "0";
  return `'${String(value).replaceAll("'", "''")}'`;
}

await exportSchema();
